# Copy to .env and adjust. All variables are optional; sane defaults apply.

# Directory for scraped output and crawl state (default: ./data)
SLT_DATA_DIR=./data

# Global HTTP settings
SLT_HTTP_TIMEOUT=30
SLT_HTTP_MAX_RETRIES=4
SLT_HTTP_USER_AGENT=saudi-law-tracker/0.1 (+research; contact: you@example.com)

# Politeness: seconds between requests to the same host
SLT_REQUEST_DELAY=2.0

# Concurrency across sources
SLT_MAX_CONCURRENCY=4

# Logging: DEBUG | INFO | WARNING | ERROR
SLT_LOG_LEVEL=INFO

# Optional: webhook for new-document notifications (Slack-compatible)
SLT_NOTIFY_WEBHOOK_URL=
